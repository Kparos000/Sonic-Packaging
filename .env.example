# ============================================================================
# SONIC PACKAGING — ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env (local development) and fill in real values.
# Never commit the real .env file — it's already in .gitignore.
# On Vercel, add each of these under Project Settings → Environment Variables
# instead of uploading a file.
# ============================================================================

# ---- Database (PostgreSQL — Neon recommended, see README.md) --------------
# Neon's pooled connection string, from your Neon project's "Connection
# Details" (the one with "-pooler" in the hostname). Used by the app at
# runtime AND for running migrations — if a migration ever fails with a
# prepared-statement error under PgBouncer, temporarily swap this for
# Neon's *direct* (non-pooled) connection string just for that command.
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/sonic_packaging?sslmode=require"

# ---- Admin authentication ---------------------------------------------------
# A long random secret used to sign admin session cookies. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"

# ---- Public URLs (no secrets — safe to expose to the browser) -------------
NEXT_PUBLIC_SITE_URL="https://sonicpackaging.com"
NEXT_PUBLIC_ADMIN_URL="https://admin.sonicpackaging.com"

# ---- Media storage (Vercel Blob) -------------------------------------------
# Created automatically when you add the Blob storage integration in your
# Vercel project. For local development, copy the token from Vercel or run
# `vercel env pull`.
BLOB_READ_WRITE_TOKEN=""

# ---- Zoho CRM (optional — leave blank to run with sync disabled) ----------
# Server-to-server OAuth app credentials from the Zoho API Console.
ZOHO_CLIENT_ID=""
ZOHO_CLIENT_SECRET=""
ZOHO_REFRESH_TOKEN=""
ZOHO_ACCOUNTS_URL="https://accounts.zoho.com"
ZOHO_API_DOMAIN="https://www.zohoapis.com"

# ---- First admin account (used only by `prisma/seed.ts`) ------------------
# After the first run, log in and change the password — these two values
# are not read anywhere else in the app.
SEED_SUPER_ADMIN_NAME="Sonic Admin"
SEED_SUPER_ADMIN_EMAIL="admin@sonicpackaging.com"
SEED_SUPER_ADMIN_PASSWORD="change-this-before-seeding"
